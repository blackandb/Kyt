# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Recipient of alert emails
OWNER_EMAIL=you@example.com

# Public URL of the deployed app (no trailing slash)
APP_URL=https://your-app.vercel.app

# Display timezone
APP_TIMEZONE=Europe/Chisinau

# Secret used by the scheduler to call /api/cron/sync
CRON_SECRET=generate-a-long-random-string

# TronGrid API key (free at trongrid.io) — recommended
TRONGRID_API_KEY=

# Email alerts (Resend)
RESEND_API_KEY=
ALERT_FROM=KYT Monitor <alerts@yourdomain.com>

# Sanctions list (TRON addresses, one per line)
SANCTIONS_TRX_URL=https://raw.githubusercontent.com/0xB10C/ofac-sanctioned-digital-currency-addresses/lists/sanctioned_addresses_TRX.txt

# AI assistant (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional deep check provider (AMLBot)
AMLBOT_ACCESS_ID=
AMLBOT_ACCESS_KEY=
AMLBOT_API_URL=https://extrnlapiendpoint.silencatech.com/
